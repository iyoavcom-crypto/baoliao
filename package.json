{
  "name": "baoliaoim-api",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "description": "Strongly-typed WS protocol + router + client + minimal gateway (Node 22 / ESM / TypeScript).",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:server": "tsx examples/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "node scripts/lint-imports.mjs",
    "test:api": "tsx tests/http-api/test-runner.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "tsx data/seeds/loader.ts",
    "seed:roles": "tsx data/seeds/loader.ts"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "jose": "^6.1.3",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.3",
    "sqlite3": "^5.1.7",
    "toml": "^3.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^4.0.16"
  }
}
